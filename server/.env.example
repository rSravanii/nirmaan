PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# Persistent database for deployment. If omitted in development, an in-memory demo DB is used.
MONGODB_URI=
ALLOW_MEMORY_DB_FALLBACK=true

# Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# AI: Gemini is used when AI_API_KEY is present; otherwise the deterministic demo provider is used.
AI_PROVIDER=auto
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_EMBEDDING_MODEL=gemini-embedding-001

# Similarity
DEDUP_SIMILARITY_THRESHOLD=0.80
HISTORICAL_MATCH_THRESHOLD=0.55

# Uploads
UPLOAD_DIR=uploads
